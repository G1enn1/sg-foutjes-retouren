# Kopieer naar .env en vul in. Laad met bijv. `set -a; source .env; set +a`
# of via python-dotenv. Commit .env NOOIT (staat in .gitignore).

# --- Voys / VoIPGRID (telefoon, Call Detail Records) ---
# Voys draait op het VoIPGRID-platform. Maak een API-token aan onder je
# VoIPGRID-account en gebruik je login-e-mail als user.
VOIPGRID_API_URL=https://partner.voipgrid.nl
VOIPGRID_USER=jouw-login@stralendgroen.nl
VOIPGRID_TOKEN=

# --- HubSpot (e-mail, CRM API) ---
# Maak een Private App aan (Instellingen > Integraties > Private Apps) met scopes:
#   sales-email-read, crm.objects.owners.read, tickets (indien je categorieën wilt)
HUBSPOT_TOKEN=

# --- Google Sheets export (optioneel) ---
# GOOGLE_SERVICE_ACCOUNT_JSON=/pad/naar/service-account.json
# GSHEET_ID=
